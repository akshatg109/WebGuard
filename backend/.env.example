# SERVER ONLY — FastAPI runtime. Never copy these into NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Must match the Next.js server-only SCANNER_API_TOKEN. Generate a random secret.
SCANNER_API_TOKEN=

# Exact frontend origins only. Production origins must use HTTPS.
ALLOWED_ORIGINS=http://localhost:3000
SCAN_RATE_LIMIT_MAX_REQUESTS=5
SCAN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional server-only AI guidance. No calls are made unless a user explicitly
# requests a summary or finding explanation from a completed, owned scan.
# Supported providers: openai, openrouter, openai-compatible.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Required for openai-compatible; optional override for OpenAI/OpenRouter.
# Use HTTPS except for local loopback development URLs.
AI_BASE_URL=
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=3600

# Safe scanner policy limits. Every target/redirect uses these controls.
SCANNER_ALLOWED_SCHEMES=http,https
SCANNER_ALLOWED_PORTS=80,443,8080,8443
SCANNER_MAX_URL_LENGTH=2048
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1000000
SCANNER_MAX_CONNECTIONS=10
SCANNER_MAX_RESPONSE_HEADERS=128
SCANNER_MAX_HEADER_LINE_BYTES=8190
SCANNER_MAX_HEADER_FIELD_BYTES=8190
SCANNER_READ_CHUNK_BYTES=16384
SCANNER_DNS_TIMEOUT_SECONDS=3
SCANNER_CONNECT_TIMEOUT_SECONDS=3
SCANNER_WRITE_TIMEOUT_SECONDS=3
SCANNER_READ_TIMEOUT_SECONDS=8
SCANNER_OVERALL_TIMEOUT_SECONDS=30
