# Existing server-only integrations. Never expose these to frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SCANNER_API_TOKEN=replace-with-a-server-only-token
ALLOWED_ORIGINS=http://localhost:3000

# Phase 4A scanner limits. The scanner is not exposed through an API endpoint yet.
SCANNER_ALLOWED_SCHEMES=http,https
SCANNER_ALLOWED_PORTS=80,443,8080,8443
SCANNER_MAX_URL_LENGTH=2048
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1000000
SCANNER_MAX_CONNECTIONS=10
SCANNER_MAX_RESPONSE_HEADERS=128
SCANNER_MAX_HEADER_LINE_BYTES=8190
SCANNER_MAX_HEADER_FIELD_BYTES=8190
SCANNER_READ_CHUNK_BYTES=16384
SCANNER_DNS_TIMEOUT_SECONDS=3
SCANNER_CONNECT_TIMEOUT_SECONDS=3
SCANNER_WRITE_TIMEOUT_SECONDS=3
SCANNER_READ_TIMEOUT_SECONDS=8
SCANNER_OVERALL_TIMEOUT_SECONDS=30
