# Combined local reference only. Do not load this file in the frontend or backend.
# Use frontend/.env.example for Next.js and backend/.env.example for FastAPI.

# PUBLIC — frontend/.env.local and frontend hosting build/runtime configuration
NEXT_PUBLIC_SUPABASE_URL=https://akubhdfghktuynsncdfx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY — local Next.js BFF. Never prefix these with NEXT_PUBLIC_.
SCANNER_API_URL=http://127.0.0.1:8000
SCANNER_API_TOKEN=
# Render staging uses SCANNER_API_PRIVATE_HOSTPORT from the private service's
# hostport property instead; do not set a public FastAPI URL for the BFF.

# SERVER ONLY — backend/.env and FastAPI deployment configuration
SUPABASE_URL=https://akubhdfghktuynsncdfx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
ALLOWED_ORIGINS=http://localhost:3000
SCAN_RATE_LIMIT_MAX_REQUESTS=5
SCAN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional backend-only AI guidance configuration; leave blank to disable AI.
# The provider is called only after an explicit user action on a completed scan.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional scanner policy limits for backend/.env. Keep the allowed ports exact.
SCANNER_ALLOWED_SCHEMES=http,https
SCANNER_ALLOWED_PORTS=80,443,8080,8443
SCANNER_MAX_URL_LENGTH=2048
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1000000
SCANNER_MAX_CONNECTIONS=10
SCANNER_MAX_RESPONSE_HEADERS=128
SCANNER_MAX_HEADER_LINE_BYTES=8190
SCANNER_MAX_HEADER_FIELD_BYTES=8190
SCANNER_READ_CHUNK_BYTES=16384
SCANNER_DNS_TIMEOUT_SECONDS=3
SCANNER_CONNECT_TIMEOUT_SECONDS=3
SCANNER_WRITE_TIMEOUT_SECONDS=3
SCANNER_READ_TIMEOUT_SECONDS=8
SCANNER_OVERALL_TIMEOUT_SECONDS=30
