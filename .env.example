# Browser-safe Supabase values (frontend/.env.local).
# These are public project values; RLS, not key secrecy, protects table data.
NEXT_PUBLIC_SUPABASE_URL=https://akubhdfghktuynsncdfx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js server-only values (frontend/.env.local). Never prefix these with NEXT_PUBLIC_.
SCANNER_API_URL=http://127.0.0.1:8000
SCANNER_API_TOKEN=replace-with-a-server-only-token

# FastAPI server-only values (backend/.env).
SUPABASE_URL=https://akubhdfghktuynsncdfx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SCANNER_API_TOKEN=replace-with-the-same-server-only-token
ALLOWED_ORIGINS=http://localhost:3000

# Optional copy of scanner limits for backend/.env (see backend/.env.example).
SCANNER_ALLOWED_SCHEMES=http,https
SCANNER_ALLOWED_PORTS=80,443,8080,8443
SCANNER_MAX_URL_LENGTH=2048
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1000000
SCANNER_MAX_CONNECTIONS=10
SCANNER_MAX_RESPONSE_HEADERS=128
SCANNER_MAX_HEADER_LINE_BYTES=8190
SCANNER_MAX_HEADER_FIELD_BYTES=8190
SCANNER_READ_CHUNK_BYTES=16384
SCANNER_DNS_TIMEOUT_SECONDS=3
SCANNER_CONNECT_TIMEOUT_SECONDS=3
SCANNER_WRITE_TIMEOUT_SECONDS=3
SCANNER_READ_TIMEOUT_SECONDS=8
SCANNER_OVERALL_TIMEOUT_SECONDS=30
